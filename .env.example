# Application Configuration
APP_NAME=PDF Extraction Service
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_PATH=./data/app.db

# Security
# Auth is off by default so the service starts with no configuration.
# Turn it on and set at least one key before exposing this beyond localhost.
AUTH_ENABLED=false
API_KEYS=
API_KEY_HEADER=X-API-Key
# Comma-separated origins, or * for any. Credentials are only honoured
# alongside an explicit list — browsers reject * with credentials.
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# Processing Limits & Validation
MAX_UPLOAD_SIZE_MB=100
MAX_PAGES_PER_DOCUMENT=1000
PDF_MIN_TEXT_LENGTH=200
PDF_MIN_TEXT_DENSITY=0.005
PDF_MIN_IMAGE_AREA_RATIO=0.35

# Storage Configuration (AWS S3 & Local Fallback)
AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=pdf-processing-bucket
S3_PRESIGNED_EXPIRATION_SECONDS=3600
LOCAL_STORAGE_DIR=./data/output
TEMP_DIR=./data/temp

# Groq Vision Provider Configuration
GROQ_ENABLED=false
GROQ_API_KEY=
# The llama-3.2-*-vision-preview ids were retired by Groq.
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_REQUESTS_PER_SECOND=1
GROQ_REQUESTS_PER_MINUTE=20
GROQ_REQUESTS_PER_HOUR=500
GROQ_REQUESTS_PER_DAY=1000
GROQ_MIN_REQUEST_GAP_SECONDS=2
GROQ_MAX_RETRIES=3
GROQ_TIMEOUT_SECONDS=30.0

# Background Worker & Recovery
WORKER_ENABLED=true
WORKER_COUNT=1
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
JOB_STALE_TIMEOUT_SECONDS=120
JOB_MAX_ATTEMPTS=3
# How often the pool re-sweeps for stale jobs while running.
RECOVERY_SWEEP_INTERVAL_SECONDS=60

# Output Configuration
TXT_INCLUDE_PAGE_MARKERS=true
TXT_INCLUDE_METADATA=true

# Logging
LOG_LEVEL=INFO
LOG_TO_DATABASE=true
LOG_DIR=./logs
